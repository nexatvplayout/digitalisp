# DIGITAL ISP: variáveis do servidor. Copie para .env (que nunca vai para o repositório) e preencha.
# Sem nada disso, o servidor sobe em modo de desenvolvimento: SQLite em ./data e arquivos locais.

# --- obrigatórias em produção (NODE_ENV=production) ---
NODE_ENV=production
PORT=3000
# chave que assina as sessões: 32 caracteres ou mais, aleatória
SESSION_SECRET=
# equipe da plataforma (DIGITAL ISP): criada uma vez, no primeiro boot
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=
# administrador da revenda padrão (id 1, a própria DIGITAL ISP vendendo direto)
ADMIN_USER=admin
ADMIN_PASSWORD=
# endereço público https do painel (as telas e os links de controle usam este)
PLATFORM_PUBLIC_URL=https://painel.digitalisp.com.br

# --- banco: Postgres novo, só do DIGITAL ISP (sem ele: SQLite em DATA_DIR) ---
DATABASE_URL=

# --- arquivos: Cloudflare R2, bucket novo só do DIGITAL ISP (sem ele: disco local em DATA_DIR) ---
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# domínio público do bucket (opcional; sem ele, links assinados de curta duração)
R2_PUBLIC_URL=

# --- opcionais ---
# DATA_DIR=./data          pasta local (banco SQLite, cache, imagens)
# TRUST_PROXY=1            atrás de proxy/Cloudflare
# CORS_ORIGINS=            outras origens do painel, separadas por vírgula
# NTP_SYNC=0               desliga o relógio por NTP
# HOST=127.0.0.1           escutar só na própria máquina (atrás do túnel da Cloudflare)
# CF_TUNNEL=1              atrás do cloudflared: o IP real vem no CF-Connecting-IP

# --- e-mail: "Esqueci minha senha" no login da revenda e do cliente (sem SMTP_URL, o link não aparece) ---
# qualquer provedor com SMTP (Amazon SES, Resend, Brevo, Mailgun, Zoho...). smtps:// = porta 465; smtp:// = 587 com STARTTLS
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
# MAIL_FROM=DIGITAL ISP <nao-responda@digitalisp.com.br>
